# --- OCR Recognition ---
# Online OCR (LlamaParse) - Get free key at https://cloud.llamaindex.ai
LLAMAPARSE_API_KEY=your-llamaparse-api-key-here

# --- LLM API (Advanced / Legacy) ---
PDFCUTTER_API_BASE_URL=https://openrouter.ai/api/v1
PDFCUTTER_API_KEY=your-llm-api-key-here
PDFCUTTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
PDFCUTTER_TIMEOUT=60
PDFCUTTER_SYSTEM_PROMPT=You are an expert at extracting tables of contents from book pages.
